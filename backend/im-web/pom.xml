<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.linjian</groupId>
        <artifactId>linjian-im</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-web</artifactId>
    <name>im-web</name>
    <description>启动类、STOMP 端点、Controller、安全配置</description>

    <dependencies>
        <dependency>
            <groupId>com.linjian</groupId>
            <artifactId>im-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.linjian</groupId>
            <artifactId>im-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-messaging</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!--
            把项目根目录的 sql/schema.sql 也纳入 classpath。
            目的只有一个：集成测试可以直接复用生产的那份 DDL 初始化 im_test 库，
            而不是另维护一份「测试专用建表脚本」——两份脚本一定会漂移，
            等到测试库和生产库结构不一致时，红灯指向的是一个不存在的问题。
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- im-web 位于 backend/im-web，项目根的 sql 目录要上溯两级 -->
                <directory>${project.basedir}/../../sql</directory>
                <includes>
                    <include>schema.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
