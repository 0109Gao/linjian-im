# 复制为 .env 后按需修改；.env 不入库。
# 关键项：IM_JWT_SECRET 不设置时应用会直接拒绝启动，这是刻意设计。

# JWT 签名密钥，HS384 要求至少 48 字节。生成方式：
#   openssl rand -base64 48     或     python -c "import secrets;print(secrets.token_urlsafe(48))"
IM_JWT_SECRET=

# 数据库连接（对应 docker/docker-compose.yml 中的 3307 端口）
IM_DB_USER=im
IM_DB_PASSWORD=im123456

# 雪花算法机器号，单机固定为 1
IM_WORKER_ID=1
